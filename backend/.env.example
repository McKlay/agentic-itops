# ============================================================
# falcon-ai-ops-agent — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- ServiceNow ---
SNOW_INSTANCE_URL=https://yourinstance.service-now.com
SERVICENOW_USERNAME=svc_ai_ops
SERVICENOW_PASSWORD=REPLACE_ME

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=ka-embedding-model
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=REPLACE_ME
AZURE_SEARCH_INDEX_NAME=ka-vector

# --- Entra ID (JWT Auth) ---
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
# Set to true ONLY in local development to bypass JWT validation
AUTH_DISABLED=false

# --- Microsoft Teams ---
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/REPLACE_ME

# --- Memory Tier 1 (Redis — optional) ---
# Leave blank to use in-memory MemorySaver fallback
REDIS_URL=

# --- Memory Tier 3 (Domain Store) ---
# Allowed values: memory | cosmos | azure_table
STORAGE_BACKEND=memory
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=ai-ops-agent
AZURE_TABLE_CONNECTION_STRING=

# --- Application ---
LOG_LEVEL=INFO
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173
